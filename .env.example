# ---------------------------------------------------------------------------
# Toolz environment variables
#
# Copy this file to `.env.local` and fill in values you actually have.
# Everything here is optional for local development: the app builds and runs
# with no environment variables at all. Placeholders are NEVER invented for
# you — if a value is missing, the related feature stays switched off.
# ---------------------------------------------------------------------------

# Canonical origin used for canonicals, sitemap, robots.txt and JSON-LD @id.
# No trailing slash. Until this is set the build falls back to
# https://toolz.name.ng and `siteUrlIsPlaceholder` is true.
NEXT_PUBLIC_SITE_URL=https://toolz.name.ng

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to load no
# analytics at all. Analytics only initialises after a visitor accepts the
# cookie banner, and never on the first paint.
NEXT_PUBLIC_GA_ID=

# AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX). Supplied by Google after your
# site is approved. Leave empty before approval — no ad script is loaded and no
# ad slot is rendered.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-9124992249317290

# Which consent UI runs. Leave empty for the built-in banner, or set "google"
# once you enable the certified CMP in AdSense > Privacy & messaging (that
# message then replaces ours, so visitors never see two prompts).
NEXT_PUBLIC_CMP_PROVIDER=

# Ad unit id for the tool-page slot (a number from the AdSense dashboard). Leave
# empty and the slot renders nothing, even with ads switched on — the site never
# invents a unit id or shows an empty ad frame.
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=

# Search-engine verification tokens. Paste the value each console gives you and
# the matching <meta> tag is emitted; leave empty and nothing is rendered — never
# invent a token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Master switch for ads. Ads render only when this is exactly "true" AND a
# publisher ID is present. Keep "false" until AdSense approval is confirmed.
NEXT_PUBLIC_ADS_ENABLED=false
